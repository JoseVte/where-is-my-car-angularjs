# Copy to .env.local (git ignored). Only variables starting with NG_APP_ reach the app.
NG_APP_VERSION=
NG_APP_COMMIT=
NG_APP_ENABLE_SENTRY=false
# Where Is My Car API, without trailing slash
NG_APP_API_URL=http://localhost:8080
# Firebase web app config (Firebase Console, Project settings, Your apps, Web app)
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=where-is-my-car-486413.firebaseapp.com
NG_APP_FIREBASE_PROJECT_ID=where-is-my-car-486413
